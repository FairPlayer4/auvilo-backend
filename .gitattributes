# Zeilenenden: im Repo und im Arbeitsbaum immer LF, auch unter Windows.
# Gilt unabhängig von der Git-Konfiguration des Rechners (CI, anderer Rechner).
* text=auto eol=lf

# Windows-Skripte brauchen CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binärdateien nie umwandeln.
*.jar      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.zip      binary
*.pdf      binary
*.keystore binary
*.jks      binary
